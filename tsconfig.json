{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"], "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests/browser"]
}
