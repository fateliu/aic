{
  "name": "manxiang-studio",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock:ui": "node scripts/dev.mjs --mock",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node server.mjs",
    "dev:mock": "npm run build && node scripts/dev-mock.mjs",
    "test": "node --test test/agent.test.mjs test/studio.test.mjs test/images.test.mjs test/references.test.mjs test/frontend.test.mjs",
    "test:ui": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
